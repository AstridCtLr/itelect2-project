# .env.example -- every variable this project reads, no real values.
# Copy this file to .env on your laptop and fill it in.
# Never commit .env.

# Local development
PORT=3000
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=itelect2_dev
DB_HOST=127.0.0.1

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=paste_your_own_64_character_hex_string_here

# Browser origins allowed to read the API, separated by commas.
CORS_ORIGIN=http://localhost:5173

# Render only -- configure these on the Web Service Environment page:
# DATABASE_URL = the PostgreSQL Internal Database URL
# JWT_SECRET   = a new secret, different from the local value
# CORS_ORIGIN  = the deployed front-end origin, if one exists
# Render supplies PORT and NODE_ENV=production automatically.
